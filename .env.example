# =================================================================
# ELSWEDY BIOMETRIC ATTENDANCE SYSTEM - BACKEND ENVIRONMENT TEMPLATE
# Copy this file to .env and configure your production values
# =================================================================

# Server Port (Auto-assigned on Render/Railway/Heroku/AWS, or default 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Database URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YourSecurePassword@elswedy-cluster.mongodb.net/elswedy_attendance?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated URL(s) of your deployed frontend)
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# JWT Secret Key (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_generate_random_64_chars_here

# JWT Expiration Duration
JWT_EXPIRY=8h
